# =============================================================
#  AI STOCK RESEARCH OFFICE  —  환경변수 예시
# =============================================================
#  이 파일을 복사해서 .env 를 만듭니다.  (setup.ps1 이 자동으로 해줍니다)
#  .env 는 절대 Git에 올라가지 않습니다.
# =============================================================

# ---- 실행 모드 ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- 포트 (흔한 번호를 피해서 잡았습니다) ----
# 다른 프로젝트가 이미 쓰고 있으면 여기 숫자만 바꾸세요.
API_PORT=8010
WEB_PORT=3010
POSTGRES_PORT=5433
REDIS_PORT=6380

# ---- PostgreSQL ----
POSTGRES_USER=airo
POSTGRES_PASSWORD=airo_local_dev_password
POSTGRES_DB=airo
# 컨테이너 내부에서는 호스트명이 airo-postgres 입니다.
DATABASE_URL=postgresql+psycopg://airo:airo_local_dev_password@localhost:5433/airo

# ---- Redis ----
REDIS_URL=redis://localhost:6380/0

# ---- 프론트엔드가 백엔드를 찾는 주소 ----
NEXT_PUBLIC_API_BASE=http://localhost:8010
NEXT_PUBLIC_WS_URL=ws://localhost:8010/ws/events

# =============================================================
#  LLM (아직 필요 없습니다. Phase 10에서 씁니다)
#  ※ 비용이 발생하므로 antking님이 직접 넣기 전까지는 비워둡니다.
#  ※ 시스템은 키가 없어도 정상 동작합니다 (MOCK 모드).
# =============================================================
LLM_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 모델은 "등급"으로 지정합니다. 실제 모델명 매핑은 config/models.yaml 한 곳에서만 합니다.
MODEL_TIER_STRONG=
MODEL_TIER_MID=
MODEL_TIER_CHEAP=

# 하루 LLM 비용 상한 (USD). 초과하면 작업을 큐에 남기고 멈춥니다.
DAILY_LLM_BUDGET_USD=5.0

# =============================================================
#  데이터 소스
# =============================================================
# SEC EDGAR 는 User-Agent 에 연락처를 반드시 넣어야 합니다 (SEC 규정).
# 형식: "이름 또는 회사명 이메일주소"
SEC_USER_AGENT=AI Stock Research Office rlawlsxo930201@gmail.com

# 시세 공급자: mock | yfinance
# yfinance 데이터는 Yahoo 약관상 개인 연구용입니다. 재배포 금지.
MARKET_DATA_PROVIDER=mock

# =============================================================
#  MOCK 모드
#  true 면 가짜 데이터로 UI가 동작하고, 화면에 MOCK DATA 배지가 뜹니다.
#  실제 데이터처럼 위장하지 않습니다.
# =============================================================
MOCK_MODE=true

# ---------------------------------------------------------------
# 영속화 (Phase 5b) — 껐다 켜도 학습이 이어집니다
# ---------------------------------------------------------------
# sqlite = 파일 하나로 저장 (설치 불필요, 권장) / off = 메모리만
PERSISTENCE=sqlite
SQLITE_PATH=data/airo.db
AUTOSAVE_EVERY_TICKS=200

# ---------------------------------------------------------------
# 실제 시장 데이터 (Phase 21)
# ---------------------------------------------------------------
# csv_file  : data/market/ 에 넣은 CSV (약관 문제 없음, 가장 확실)
# stooq     : 무료 CSV. API 키 불필요. 비공식 엔드포인트
# yfinance  : pip 설치 필요. 개인 연구용 (재배포 금지)
# off       : 실데이터를 쓰지 않고 합성(MOCK) 만 사용
MARKET_PROVIDER=csv_file
MARKET_DATA_DIR=data/market
MARKET_EXCHANGE=XNYS

# ---------------------------------------------------------------
# SEC EDGAR (Phase 12) — 무료. 다만 연락처 이메일이 '필수'입니다.
# 비워두면 요청을 아예 보내지 않습니다(차단되기 때문).
# ---------------------------------------------------------------
SEC_CONTACT_EMAIL=

# ---------------------------------------------------------------
# 한국 데이터 (둘 다 무료. 가입 후 키만 붙여넣으면 됩니다)
# ---------------------------------------------------------------
# [1] 공공데이터포털 - 금융위원회 주식시세정보 (한국 일별 시세)
#     https://www.data.go.kr  회원가입
#     -> "주식시세정보" 검색 -> 금융위원회_주식시세정보 -> 활용신청(자동승인)
#     -> 마이페이지 > 데이터활용 > Open API > 인증키
#     ※ '일반 인증키(Decoding)' 를 권장합니다. Encoding 키를 넣어도 동작합니다.
DATA_GO_KR_KEY=

# [2] DART - 금융감독원 전자공시 (한국 공시)
#     https://opendart.fss.or.kr  회원가입 -> 인증키 신청 (40자리)
DART_API_KEY=

# 기본 거래소 (한국 종목을 주로 보신다면 XKRX)
# MARKET_EXCHANGE=XKRX
